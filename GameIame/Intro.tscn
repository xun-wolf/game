margin_bottom = 86.0
text = "耕作是一门奇特的营生。它完全依靠魔法卡组来完成，懂得这门技艺的人寥寥无几，精通者更是少之又少。

但它依然吸引着你。

尽管你对这个神秘领域一无所知，你还是为自己在乡下弄到了一座破败而古老的农场。

环顾你的新农场，你发现一块模样古怪的石头。石头下面藏着一卷落满灰尘的卷轴，还有一副落灰更厚的卡组。卷轴上写着的内容非常有用："
autowrap = true

